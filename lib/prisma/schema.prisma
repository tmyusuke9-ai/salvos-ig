datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  folders   Folder[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  cover     String?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  posts     Post[]
}

model Post {
  id        String   @id @default(cuid())
  url       String
  thumbnail String?
  caption   String?
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id])
  createdAt DateTime @default(now())
}
