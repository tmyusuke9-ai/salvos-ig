# App
PORT=4000
NODE_ENV=development

# Database (Docker Compose expõe em localhost:5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instagram_ref_hub?schema=public"

# Redis (para fila opcional de ingest/transcrição)
REDIS_URL=redis://localhost:6379

# Storage local (onde salvar downloads)
STORAGE_DIR=./storage

# Instagram Graph API (opcional - se usar oficial)
IG_GRAPH_ACCESS_TOKEN=
IG_GRAPH_USER_ID=

# Downloader público (se usar algum serviço externo via HTTP, opcional)
DOWNLOADER_API_BASE=
DOWNLOADER_API_KEY=
